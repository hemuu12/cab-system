PORT=5001
# Comma-separated list of allowed browser origins (client on 5173, client-v2 on 5174).
CLIENT_URL=http://localhost:5173,http://localhost:5174,https://cab-system-wk9q.vercel.app
# Allows this Vercel frontend project's production and preview deployment URLs.
VERCEL_FRONTEND_PROJECT=wondertravel
VERCEL_FRONTEND_TEAM=hemuu12s-projects
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/wondertravel
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30
OTP_SECRET=replace-with-a-different-random-secret

# Leave blank locally to print the OTP in the server terminal.
# In production, create an API key at https://resend.com and verify your sender domain.
RESEND_API_KEY=
RESEND_FROM=WonderTravel <bookings@yourdomain.com>
# Inbox that gets notified the moment a Quick booking enquiry comes in.
NOTIFY_EMAIL=
